@{
    ViewData["Title"] = "Inicio";
}

<section class="portada" aria-labelledby="portada-titulo">
    <div class="portada-texto">
        <h1 id="portada-titulo" class="portada-titulo">Sistema de biblioteca</h1>
        <p class="portada-lema">
            Registre libros y socios, y consulte los préstamos por rango de fechas.
        </p>
        <div class="portada-acciones">
            <a asp-controller="Libros" asp-action="Index" class="btn-tinta">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="6.5" />
                    <path d="m20 20-4.2-4.2" />
                </svg>
                Ver libros
            </a>
            <a asp-controller="Prestamos" asp-action="Reporte" class="btn-sutil">Ver préstamos</a>
        </div>
    </div>

    <div class="estante" aria-hidden="true">
        <div class="estante-libros">
            <span class="lomo" style="--ancho: 2.1rem; --alto: 78%; --color: #1d3a33;"></span>
            <span class="lomo" style="--ancho: 2.7rem; --alto: 92%; --color: #7a2e24;"><span>Rayuela</span></span>
            <span class="lomo lomo-claro" style="--ancho: 1.8rem; --alto: 70%; --color: #e2cfa4;"></span>
            <span class="lomo" style="--ancho: 2.4rem; --alto: 86%; --color: #2f5a4f;"><span>Ficciones</span></span>
            <span class="lomo" style="--ancho: 1.6rem; --alto: 74%; --color: #3b3f52;"></span>
            <span class="lomo lomo-claro" style="--ancho: 2.5rem; --alto: 96%; --color: #d6b46c;"><span>Pedro Páramo</span></span>
            <span class="lomo" style="--ancho: 2rem; --alto: 82%; --color: #8a6420;"></span>
            <span class="lomo" style="--ancho: 2.3rem; --alto: 88%; --color: #24463e;"><span>El Aleph</span></span>
            <span class="lomo" style="--ancho: 1.9rem; --alto: 76%; --color: #9b3326;"></span>
            <span class="sujetalibros"></span>
        </div>
        <div class="estante-tabla"></div>
    </div>
</section>

<section class="entradas" aria-label="Secciones de la biblioteca">
    <a class="entrada" asp-controller="Libros" asp-action="Index">
        <span class="entrada-icono" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3.5" y="4" width="4.5" height="16" rx="1" />
                <rect x="9" y="6.5" width="4.5" height="13.5" rx="1" />
                <path d="m14.6 8.2 4.1-1.1 3.1 11.7-4.1 1.1z" />
            </svg>
        </span>
        <h2 class="entrada-titulo">Libros</h2>
        <p class="entrada-texto">Registrar, editar, eliminar y buscar libros por título.</p>
        <span class="entrada-ir">
            Ir a libros
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </span>
    </a>

    <a class="entrada" asp-controller="Socios" asp-action="Index">
        <span class="entrada-icono" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="8.5" r="3.25" />
                <path d="M3.5 19.5c.8-3.3 3-5.2 5.5-5.2s4.7 1.9 5.5 5.2" />
                <path d="M15.5 5.4a3.25 3.25 0 0 1 0 6.2" />
                <path d="M17.6 14.6c1.6.7 2.6 2.4 2.9 4.9" />
            </svg>
        </span>
        <h2 class="entrada-titulo">Socios</h2>
        <p class="entrada-texto">Lista de socios y registro de socios nuevos.</p>
        <span class="entrada-ir">
            Ir a socios
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </span>
    </a>

    <a class="entrada" asp-controller="Prestamos" asp-action="Reporte">
        <span class="entrada-icono" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="5" y="4.5" width="14" height="16" rx="2" />
                <path d="M9 4.5V3h6v1.5" />
                <path d="M8.5 10h7M8.5 13.5h7M8.5 17h4" />
            </svg>
        </span>
        <h2 class="entrada-titulo">Reporte de préstamos</h2>
        <p class="entrada-texto">Préstamos entre dos fechas con su estado.</p>
        <span class="entrada-ir">
            Ver reporte
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </span>
    </a>
</section>
