@model IEnumerable<Libro>
@*
    Solo filas <tr>: Index la pone dentro de su <tbody> y la búsqueda en vivo
    la recibe como PartialView para reemplazar ese mismo <tbody>.
*@
@{
    var busqueda = ViewData["Busqueda"] as string;
}
@if (!Model.Any())
{
    <tr class="fila-vacia">
        <td colspan="5">
            <div class="vacio">
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="9" y="8" width="24" height="32" rx="3" />
                    <path d="M15 16h12M15 22h12M15 28h6" />
                    <circle cx="33" cy="32" r="7" fill="#fffcf5" />
                    <path d="m38 37 4.5 4.5" />
                </svg>
                @if (!string.IsNullOrEmpty(busqueda))
                {
                    <p class="vacio-titulo">No se encontraron libros con "@busqueda"</p>
                }
                else
                {
                    <p class="vacio-titulo">No hay libros registrados</p>
                }
            </div>
        </td>
    </tr>
}
else
{
    foreach (var libro in Model)
    {
        <partial name="_LibroFila" model="libro" />
    }
}
