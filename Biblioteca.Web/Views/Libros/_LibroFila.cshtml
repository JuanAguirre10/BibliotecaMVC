@model Libro
@*
    Única vista que dibuja la fila de un libro.
    La usan el listado (Index) y los resultados de la búsqueda en vivo (_LibrosResultados).
*@
@{
    // Iniciales del autor para el avatar: primera letra del primer y del último nombre.
    var autor = string.IsNullOrWhiteSpace(Model.AutorNombre) ? "Sin autor" : Model.AutorNombre.Trim();
    var partes = autor.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var iniciales = (partes.Length > 1 ? $"{partes[0][0]}{partes[^1][0]}" : autor[..1]).ToUpperInvariant();
    var tono = autor.Sum(c => (int)c) % 5;
}
<tr data-libro="@Model.LibroId">
    <td>
        <a asp-controller="Libros" asp-action="Details" asp-route-id="@Model.LibroId" class="fila-titulo">@Model.Titulo</a>
    </td>
    <td>
        <span class="autor">
            <span class="avatar tono-@tono" aria-hidden="true">@iniciales</span>
            <span>@autor</span>
        </span>
    </td>
    <td><span class="mono">@Model.ISBN</span></td>
    <td>
        @if (Model.Disponible)
        {
            <span class="pastilla pastilla-ok">@Model.Ejemplares @(Model.Ejemplares == 1 ? "disponible" : "disponibles")</span>
        }
        else
        {
            <span class="pastilla pastilla-alerta">Agotado</span>
        }
    </td>
    <td class="acciones">
        <span class="acciones-grupo">
            <a asp-controller="Libros" asp-action="Details" asp-route-id="@Model.LibroId" class="btn-icono"
               title="Ver detalle" aria-label="Ver detalle de @Model.Titulo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2.5 12s3.5-6.5 9.5-6.5 9.5 6.5 9.5 6.5-3.5 6.5-9.5 6.5S2.5 12 2.5 12z" />
                    <circle cx="12" cy="12" r="2.75" />
                </svg>
            </a>
            <a asp-controller="Libros" asp-action="Edit" asp-route-id="@Model.LibroId" class="btn-icono"
               title="Editar" aria-label="Editar @Model.Titulo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 20h4L19 9a2.12 2.12 0 0 0-3-3L5 17z" />
                    <path d="m14 7 3 3" />
                </svg>
            </a>
            <a asp-controller="Libros" asp-action="Delete" asp-route-id="@Model.LibroId" class="btn-icono btn-icono-peligro"
               title="Eliminar" aria-label="Eliminar @Model.Titulo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 7h16" />
                    <path d="M9 7V4.5h6V7" />
                    <path d="m6 7 1 13h10l1-13" />
                    <path d="M10 11v5.5M14 11v5.5" />
                </svg>
            </a>
        </span>
    </td>
</tr>
